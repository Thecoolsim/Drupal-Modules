<?php
/**
 * @file
 * A module to remove default book navigation from book pages.
 */

/**
 * Implements hook_menu_alter().
 */
function book_navigation_remover_menu_alter(&$items) {
  // If the 'book_navigation' menu item exists, we'll override its access callback
  if (isset($items['book_navigation'])) {
    $items['book_navigation']['access callback'] = 'book_navigation_remover_access';
  }
}

/**
 * Access callback for book navigation.
 * Always returns FALSE to prevent access to default book navigation.
 */
function book_navigation_remover_access() {
  return FALSE;
}

/**
 * Implements hook_node_view_alter().
 */
function book_navigation_remover_node_view_alter(&$build) {
  // Remove book navigation links from node view
  if (isset($build['book_navigation'])) {
    unset($build['book_navigation']);
  }
}

/**
 * Implements hook_page_alter().
 */
function book_navigation_remover_page_alter(&$page) {
  // Remove book navigation from page rendering
  if (isset($page['content']['book_navigation'])) {
    unset($page['content']['book_navigation']);
  }
}

/**
 * Implements hook_block_info_alter().
 */
function book_navigation_remover_block_info_alter(&$blocks, $theme, $code_blocks) {
  // Make the book navigation block invisible
  if (isset($blocks['book']['navigation'])) {
    $blocks['book']['navigation']['status'] = 0;
    $blocks['book']['navigation']['region'] = -1;
  }
}

/**
 * Implements hook_theme_registry_alter().
 */
function book_navigation_remover_theme_registry_alter(&$theme_registry) {
  // Override the book navigation theme function
  if (isset($theme_registry['book_navigation'])) {
    $theme_registry['book_navigation']['function'] = 'book_navigation_remover_book_navigation';
  }
}

/**
 * Override theme_book_navigation() to return empty string.
 */
function book_navigation_remover_book_navigation($variables) {
  // Return empty string instead of book navigation HTML
  return '';
}
